# Django Settings
DJANGO_DEBUG=0
DJANGO_SETTINGS_MODULE=production_control.settings
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
ALLOWED_HOSTS=tu-app.up.railway.app

# CSRF y Seguridad
CSRF_TRUSTED_ORIGINS=https://tu-app.up.railway.app
SECURE_COOKIES=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1

# Base de Datos PostgreSQL
# Nota: Railway proporciona POSTGRES_URL_NON_POOLING automáticamente
# También puedes usar estas variables individuales:
DB_ENGINE=postgresql
POSTGRES_DB=railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu-password-de-railway
POSTGRES_HOST=tu-host-de-railway.railway.internal
POSTGRES_PORT=5432
